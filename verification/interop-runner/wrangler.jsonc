// The Cloudflare Worker that serves the web pages of the Interop runner
// workflow at https://opengensokyo.net/interop/: static assets only, from
// ./site, where the workflow's deploy job puts the output of
// `pages.py site` (and `pages.py history`) as site/interop/.
{
  "name": "ogn-interop",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "opengensokyo.net/interop", "zone_name": "opengensokyo.net" },
    { "pattern": "opengensokyo.net/interop/*", "zone_name": "opengensokyo.net" }
  ]
}
